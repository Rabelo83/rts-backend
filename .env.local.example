# Local development environment — copy to .env.local and fill in your values
# .env.local is gitignored and will NOT be committed.

# ─── Required ─────────────────────────────────────────────────────────────────

# Anthropic Claude API key — powers the main chat agent (routes/agent_claude.py)
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Bustime / RTS real-time API
BUS_API_KEY=your_bustime_key_here
# Optional: comma-separated authorized fallback keys. Used only when BusTime
# reports the current key has reached its daily transaction limit.
BUS_API_KEYS=
RTPIDATAFEED=bustime

# ─── Persistent data (Render: leave blank, render.yaml sets DATA_DIR=/data) ──
# On Render, DATA_DIR=/data is set by render.yaml (persistent disk mount).
# Locally, leave blank — data lands under ./data and ./db in the repo.
DATA_DIR=

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate keys: python scripts/generate_vapid_keys.py
# BACK THESE UP — losing them disconnects every existing subscriber.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT overrides agency_config contact.email; leave blank to use config.
VAPID_SUBJECT=

# Set to false to disable the 60s background push checker (useful in tests/dev)
ENABLE_ALERT_SCHEDULER=true

# ─── Optional: fallback LLM (Ollama / OpenAI) ─────────────────────────────────
# Only needed if you use routes/agent_v2.py or routes/agent_gpt_v3.py.
# For local Ollama: point OPENAI_BASE_URL at http://localhost:11434/v1
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.1:8b
HUMANIZE_MODEL=llama3.1:8b
CLARIFY_MODEL=llama3.1:8b
SUMMARY_MODEL=llama3.1:8b
HUMANIZE_ENABLED=true

# ─── Optional: premium geocoding ──────────────────────────────────────────────
# Default provider is Nominatim (free, rate-limited). Set GEOCODING_PROVIDER
# to "google" or "mapbox" to use a paid provider with the key below.
GEOCODING_PROVIDER=nominatim
GOOGLE_GEOCODING_KEY=
MAPBOX_TOKEN=

# ─── Optional: debug flags ────────────────────────────────────────────────────
SCHEDULE_DEBUG=true
CHAT_LOG_ENABLED=false
