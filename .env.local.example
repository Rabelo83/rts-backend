# Local development environment — copy to .env.local and fill in your values
# .env.local is gitignored and will NOT be committed.

# --- Bustime / RTS real-time API ---
BUS_API_KEY=your_bustime_key_here
RTPIDATAFEED=bustime

# --- Local LLM via Ollama ---
# Point the OpenAI client at your local Ollama server.
# Ollama exposes an OpenAI-compatible API at http://localhost:11434/v1
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.1:8b
HUMANIZE_MODEL=llama3.1:8b
CLARIFY_MODEL=llama3.1:8b
SUMMARY_MODEL=llama3.1:8b
HUMANIZE_ENABLED=true

# --- Optional debug flags ---
SCHEDULE_DEBUG=true
CHAT_LOG_ENABLED=false
